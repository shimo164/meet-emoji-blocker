{
  "manifest_version": 3,
  "name": "Meet Emoji Blocker",
  "version": "0.2.0",
  "description": "Hide Google Meet reaction emoji buttons to prevent accidental clicks.",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
